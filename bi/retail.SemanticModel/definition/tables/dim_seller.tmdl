table dim_seller

	column seller_sk
		dataType: string
		summarizeBy: none
		sourceColumn: seller_sk

	column seller_id
		dataType: string
		summarizeBy: none
		sourceColumn: seller_id

	column seller_zip_code_prefix
		dataType: int64
		summarizeBy: none
		sourceColumn: seller_zip_code_prefix

	column seller_city
		dataType: string
		summarizeBy: none
		sourceColumn: seller_city

	column seller_state
		dataType: string
		summarizeBy: none
		sourceColumn: seller_state

	column valid_from
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: valid_from

	column valid_to
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: valid_to

	column is_current
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_current

	column is_deleted
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_deleted

	column is_first_version
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_first_version

	partition dim_seller = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(GoldFolder & "\dim_seller.parquet"))
				in
				    Source
