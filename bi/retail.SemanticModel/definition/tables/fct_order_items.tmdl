table fct_order_items

	measure Revenue =
			// dbt metric: revenue (analytics/models/metrics/)
			CALCULATE(
				SUM(fct_order_items[item_revenue]),
				KEEPFILTERS(fct_order_items[is_revenue_order] = TRUE())
			)
		formatString: #,##0.00

	column order_id
		dataType: string
		summarizeBy: none
		sourceColumn: order_id

	column order_item_id
		dataType: int64
		summarizeBy: none
		sourceColumn: order_item_id

	column product_sk
		dataType: string
		summarizeBy: none
		sourceColumn: product_sk

	column seller_sk
		dataType: string
		summarizeBy: none
		sourceColumn: seller_sk

	column product_id
		dataType: string
		summarizeBy: none
		sourceColumn: product_id

	column seller_id
		dataType: string
		summarizeBy: none
		sourceColumn: seller_id

	column order_purchase_ts_utc
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: order_purchase_ts_utc

	column shipping_limit_ts_utc
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: shipping_limit_ts_utc

	column price
		dataType: decimal
		summarizeBy: sum
		sourceColumn: price

	column freight_value
		dataType: decimal
		summarizeBy: sum
		sourceColumn: freight_value

	column is_deleted
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_deleted

	column order_purchase_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: order_purchase_date

		annotation UnderlyingDateTimeDataType = Date

	column is_revenue_order
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_revenue_order

	column item_revenue
		dataType: decimal
		summarizeBy: sum
		sourceColumn: item_revenue

	partition fct_order_items = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(GoldFolder & "\fct_order_items.parquet"))
				in
				    Source
