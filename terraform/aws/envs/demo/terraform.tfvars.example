region          = "eu-west-1"
env             = "demo"
github_repo     = "<owner>/retail-data-platform"
alert_email     = "you@example.com"
tf_state_bucket = "retail-data-platform-tfstate-<account-id>"
tf_lock_table   = "retail-data-platform-tf-locks"
force_destroy   = true

serving_image_tag    = "<git-sha>"
serving_allowed_cidr = "<your-ip>/32"
# enable_serving     = true # creates the ALB (~$17/month idle) + ECS service

# second apply, from the terraform/snowflake outputs (two-step apply)
# snowflake_iam_user_arn = "<storage_aws_iam_user_arn>"
# snowflake_external_id  = "<storage_aws_external_id>"
# snowflake_sqs_arn      = "<pipe_notification_channel>"
