# Postgres superuser name for the OLTP database
POSTGRES_USER=retail
# Postgres superuser password (local dev only)
POSTGRES_PASSWORD=retail
# Default database name
POSTGRES_DB=retail
# Host port Postgres is published on
POSTGRES_PORT=5432
# Connection string used by host-side tools such as the replayer
POSTGRES_DSN=postgresql://retail:retail@localhost:5432/retail
# MinIO root user (S3-compatible lakehouse storage)
MINIO_ROOT_USER=minio
# MinIO root password (local dev only)
MINIO_ROOT_PASSWORD=minio12345
# Host port for the MinIO S3 API
MINIO_PORT=9000
# Host port for the MinIO web console
MINIO_CONSOLE_PORT=9001
# Bucket holding the Delta Lake tables
LAKEHOUSE_BUCKET=lakehouse
# Directory with the raw Olist CSVs (relative to repo root)
OLIST_DATA_DIR=data/raw/olist
# Kaggle username, needed by `make download`
KAGGLE_USERNAME=
# Kaggle API key, needed by `make download`
KAGGLE_KEY=
# Ollama endpoint as seen from containers (Ollama runs natively on the host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
