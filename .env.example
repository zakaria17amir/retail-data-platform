# Postgres superuser name for the OLTP database
POSTGRES_USER=retail
# Postgres superuser password (local dev only)
POSTGRES_PASSWORD=retail
# Default database name
POSTGRES_DB=retail
# Host port Postgres is published on
POSTGRES_PORT=5432
# Connection string used by host-side tools such as the replayer; port must match POSTGRES_PORT
POSTGRES_DSN=postgresql://retail:retail@127.0.0.1:5432/retail
# MinIO root user (S3-compatible lakehouse storage)
MINIO_ROOT_USER=minio
# MinIO root password (local dev only)
MINIO_ROOT_PASSWORD=minio12345
# Host port for the MinIO S3 API
MINIO_PORT=9000
# S3 endpoint for host-side Delta readers (bronze status, quality)
MINIO_ENDPOINT=http://127.0.0.1:9000
# Host port for the MinIO web console
MINIO_CONSOLE_PORT=9001
# Bucket holding the Delta Lake tables
LAKEHOUSE_BUCKET=lakehouse
# Directory with the raw Olist CSVs (relative to repo root)
OLIST_DATA_DIR=data/raw/olist
# Kaggle username, needed by `make download`
KAGGLE_USERNAME=
# Kaggle API key, needed by `make download`
KAGGLE_KEY=
# Ollama endpoint as seen from containers (Ollama runs natively on the host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Host port for the Redpanda Kafka API
REDPANDA_PORT=19092
# Host port for the Redpanda schema registry
SCHEMA_REGISTRY_PORT=18081
# Host port for Redpanda Console
CONSOLE_PORT=8080
# Host port for the Kafka Connect REST API
CONNECT_PORT=8083
# Kafka bootstrap as seen from the host (containers use redpanda:9092)
KAFKA_BOOTSTRAP=127.0.0.1:19092
# Schema registry URL as seen from the host (containers use http://redpanda:8081)
SCHEMA_REGISTRY_URL=http://127.0.0.1:18081
# Kafka Connect REST URL as seen from the host
KAFKA_CONNECT_URL=http://127.0.0.1:8083
# Replayer speed-up factor over Olist history time
REPLAY_SPEED=3600
# Clickstream simulator: fraction of events delivered late
SIM_LATE_RATE=0.05
# Clickstream simulator: maximum lateness in dataset hours
SIM_LATE_MAX_HOURS=48
# Clickstream simulator: fraction of events delivered twice
SIM_DUP_RATE=0.01
# Clickstream simulator: fraction of events deliberately corrupted
SIM_BAD_RATE=0.0
# Clickstream simulator: switch to Avro schema v2 after this many events (0 = never)
SIM_SCHEMA_EVOLVE_AFTER=0
# Clickstream simulator: non-converting sessions generated per order
SIM_BROWSING_RATIO=3
# Clickstream simulator: random seed
SIM_SEED=42
# Optional suffix for Spark's Delta txn app ids; set a new value to restart bronze from empty checkpoints without deleting tables
BRONZE_RUN_ID=
# Quality gate: allowed silver-vs-bronze distinct-key shortfall, as a fraction of bronze distinct keys
DQ_ROWCOUNT_TOLERANCE=0.001
# Quality gate: a silver table older than this many hours (max _silver_loaded_at) is a freshness warning
DQ_FRESHNESS_HOURS=2
# Gold Parquet directory written by dbt and read by `uv run --project ml`; empty = each tool's default (dbt: ../data/gold
# relative to analytics/; ml: data/gold relative to the repo root). Containers use /data/gold. A relative value here would
# resolve differently for the two, so set it only as an absolute path.
GOLD_DIR=
# DuckDB warehouse file used by the dbt `local` target; empty = ../data/warehouse/retail.duckdb (relative to analytics/)
DUCKDB_PATH=
# Snowflake account identifier for the dbt `snowflake` target (cloud path; unused locally)
SNOWFLAKE_ACCOUNT=
# Snowflake user for the dbt `snowflake` target
SNOWFLAKE_USER=
# Snowflake password for the dbt `snowflake` target
SNOWFLAKE_PASSWORD=
# Snowflake role for the dbt `snowflake` target
SNOWFLAKE_ROLE=
# Snowflake virtual warehouse for the dbt `snowflake` target
SNOWFLAKE_WAREHOUSE=
# Snowflake database holding the silver and gold schemas
SNOWFLAKE_DATABASE=
# Host port for the Airflow UI/API (profile analytics)
AIRFLOW_PORT=8088
# Airflow admin password (user `admin`); required before `make up PROFILE=analytics`, airflow-init fails if empty
AIRFLOW_ADMIN_PASSWORD=
# Airflow Fernet key (encrypts connections/variables in the metadata DB); required, keep it stable. Generate:
#   openssl rand -base64 32 | tr '+/' '-_'
AIRFLOW_FERNET_KEY=
# Host path of this repo, used by DockerOperator bind mounts through the host Docker socket (default: $PWD)
HOST_REPO_DIR=
# Airflow ingest_health: fails when the newest bronze/olist/orders ingest_ts is older than this many hours
BRONZE_FRESHNESS_HOURS=24
# Airflow gold_daily: skips the build when the last successful run ended less than this many hours ago (0 = always build)
GOLD_MIN_INTERVAL_HOURS=20
# Optional webhook (Slack-compatible) for Airflow failure alerts; empty disables alerts
ALERT_WEBHOOK_URL=
# Host port for the MLflow tracking server and UI (profile ml)
MLFLOW_PORT=5000
# MLflow tracking URI for host-side `uv run --project ml` commands (containers use http://mlflow:5000)
MLFLOW_TRACKING_URI=http://127.0.0.1:${MLFLOW_PORT}
# Host port for Redis, the Feast online store (profile ml)
REDIS_PORT=6379
# Redis URL of the Feast online store for host-side commands (containers use redis://redis:6379/0)
REDIS_URL=redis://127.0.0.1:${REDIS_PORT}/0
# Feast repo directory for host-side commands (containers use /feature_repo)
FEAST_REPO_PATH=ml/feature_repo
# Feast registry file for host-side commands (containers use /data/feast/registry.db)
FEAST_REGISTRY_PATH=data/feast/registry.db
# Host-side MLflow clients: download artefacts through the tracking server, not the presigned links it hands
# out (they point at minio:9000, which resolves only inside Compose)
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
# Champion promotion after training: auto = promote a better challenger, manual = set alias challenger only
PROMOTION_MODE=auto
# GIT_SHA (MLflow lineage tag) is not set here: `make ml-build` / `make ml` bake the short HEAD sha into retail-ml
# Airflow monitor_late_delivery: a breach retrains at most once per this many hours (0 = every breach)
RETRAIN_COOLDOWN_HOURS=72
# Monitor: breach when the share of drifted features exceeds this
DRIFT_SHARE_THRESHOLD=0.3
# Monitor: Evidently HTML reports go to <root>/late_delivery/<date>.html (s3://, file:// or a local path)
MONITORING_REPORT_ROOT=s3://lakehouse/monitoring
# Monitor: current window length in days, ending at the anchor ("now" of the simulated-live window)
MONITOR_WINDOW_DAYS=28
# Monitor: anchor = last approval day with at least this fraction of its trailing mean daily approvals
MONITOR_TAIL_RATIO=0.2
# Monitor: a smaller current window records drift but does not gate
MIN_CURRENT_ROWS=30
# Monitor: labelled orders and positives a delayed-ground-truth week needs before its PR-AUC gates
MIN_LABELLED=100
MIN_POSITIVES=10
# Monitor: rows sampled from the training window as the drift reference
REFERENCE_SAMPLE_ROWS=10000
# Host port for the late-delivery prediction API (profile ml); set 18000 if 8000 is taken
SERVING_PORT=8000
# Host port for the Feast feature server (profile realtime)
FEAST_PORT=6566
# Feast feature server URL for host-side push clients (spark-realtime uses http://feast-server:6566)
FEAST_SERVER_URL=http://127.0.0.1:${FEAST_PORT}
# spark-realtime watermarks (dataset time): must exceed the bronze inter-type commit lag (~20 h at REPLAY_SPEED=3600); popularity also covers its 24 h window
SESSION_WATERMARK=48 hours
POPULARITY_WATERMARK=49 hours
# Host port for the stream-score Prometheus metrics (profile realtime)
STREAM_SCORE_PORT=8001
# Stream scorer: flush Delta appends every STREAM_BATCH_ROWS scores or STREAM_BATCH_SECONDS, whichever comes first
STREAM_BATCH_ROWS=500
STREAM_BATCH_SECONDS=5
# Clickstream simulator feedback (`run --feedback`): /recommend base URL for the host-side sim (containers use http://serving:8000)
RECOMMEND_URL=http://127.0.0.1:${SERVING_PORT}
# Clickstream simulator feedback: click probability = CLICK_BASE / rank, x2 for a same-category item
CLICK_BASE=0.3
# Host port for Prometheus (profile observability)
PROMETHEUS_PORT=9090
# Host port for Grafana (profile observability; anonymous users get Viewer)
GRAFANA_PORT=3000
# Grafana admin password (user `admin`); required before `make up PROFILE=observability`, grafana fails to start if empty
GRAFANA_ADMIN_PASSWORD=
# LiteLLM gateway master key (must start with `sk-`); required before `make up PROFILE=genai`, litellm fails to start if empty
LITELLM_MASTER_KEY=
# LiteLLM gateway URL for host-side genai/agents commands (containers use http://litellm:4000)
LITELLM_URL=http://127.0.0.1:4000
# local = the chat/embed/judge aliases on Ollama; hosted = the *-hosted aliases (needs the matching API key below)
LLM_PROVIDER=local
# Optional hosted-model keys read by the gateway; empty disables chat-hosted (OpenAI) / judge-hosted (Anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Products enriched by a default `make enrich` run (stratified by category); `--all` enriches the full catalogue
ENRICH_LIMIT=500
# Postgres holding the rag schema (pgvector) for host-side genai/agents commands
RAG_DSN=postgresql://retail:retail@127.0.0.1:5432/retail
# Restricted order-writer role (created by sql/shop.sql) used by the shopping assistant's place_order
SHOP_DSN=postgresql://shop_writer:shop_writer@127.0.0.1:5432/retail
# Shopper preselected in the Chainlit "Shopping" profile (a real gold customer with a delivered order)
DEMO_CUSTOMER_ID=3ce436f183e68e07877b285a838db11a
# Cases per golden set in the nightly_evals DAG (local model)
EVAL_LIMIT=20
